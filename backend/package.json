{
  "name": "expo-auth-starter-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node ../scripts/run-vitest.mjs",
    "test:watch": "vitest",
    "auth:schema": "auth generate --config src/modules/auth/auth-cli.ts --output src/db/auth-schema.ts --yes",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.6.23",
    "@better-auth/expo": "1.6.23",
    "@neondatabase/serverless": "^1.1.0",
    "better-auth": "1.6.23",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^4.22.3",
    "pg": "^8.23.1",
    "zod": "^4.4.3"
  },
  "overrides": {
    "@better-auth/core": "1.6.23"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^22.19.1",
    "@types/pg": "^8.23.1",
    "auth": "1.6.23",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  }
}
