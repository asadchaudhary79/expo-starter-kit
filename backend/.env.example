NODE_ENV=development

# PostgreSQL connection. Replace this with your Neon or local database URL.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/expo_auth

# Generate with: npx auth secret
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000

# Optional comma-separated http:// or https:// browser origins.
AUTH_TRUSTED_ORIGINS=

EMAIL_FROM=Expo Auth Starter <onboarding@resend.dev>
RESEND_API_KEY=re_replace_with_your_server_only_key

# Optional Google Sign-In. Set all four together, using the same public client
# IDs as the Expo .env file.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Optional Expo push access token for enhanced security when calling Expo Push API.
# EXPO_ACCESS_TOKEN=
