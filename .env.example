# Expo app. Only public values belong here. Secrets live in backend/.env.
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_APP_ENV=development

# Optional. Set all three together, and copy the same IDs into backend/.env.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Optional iOS signing team for local/EAS builds. Not used by authentication.
# APPLE_TEAM_ID=
